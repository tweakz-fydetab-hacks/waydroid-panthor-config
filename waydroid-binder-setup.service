[Unit]
Description=Create Waydroid binder devices
After=dev-binderfs.mount
Requires=dev-binderfs.mount
Before=waydroid-container.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Verify binderfs is mounted before proceeding
ExecStartPre=/bin/test -e /dev/binderfs/binder-control
# Create binder devices (|| true: EEXIST is expected on restart)
ExecStart=/bin/sh -c 'echo binder > /dev/binderfs/binder-control || true'
ExecStart=/bin/sh -c 'echo hwbinder > /dev/binderfs/binder-control || true'
ExecStart=/bin/sh -c 'echo vndbinder > /dev/binderfs/binder-control || true'
# Create symlinks in /dev for compatibility
ExecStart=/bin/ln -sf /dev/binderfs/binder /dev/binder
ExecStart=/bin/ln -sf /dev/binderfs/hwbinder /dev/hwbinder
ExecStart=/bin/ln -sf /dev/binderfs/vndbinder /dev/vndbinder
# Verify devices were actually created
ExecStartPost=/bin/test -e /dev/binderfs/binder
ExecStartPost=/bin/test -e /dev/binderfs/hwbinder
ExecStartPost=/bin/test -e /dev/binderfs/vndbinder

[Install]
WantedBy=multi-user.target
