#!/bin/bash
# waydroid-panthor-init: First-boot Waydroid initialization for Panthor GPU
# This script runs once on first boot to initialize Waydroid with the correct
# render device for the Panthor GPU (Mali G610).
#
# Requires: waydroid-panthor-images package (provides system.img + vendor.img)
#
# This service NEVER downloads images. If images are missing, it fails fast.
# The PKGBUILD installs a symlink at /usr/share/waydroid-extra/images pointing
# to /var/lib/waydroid/images, which makes waydroid's preinstalled image
# detection kick in and set OTA to "None" (no network downloads).

set -e

FLAG_FILE="/var/lib/waydroid/.panthor-initialized"
LOG_TAG="waydroid-panthor-init"
IMAGES_DIR="/var/lib/waydroid/images"
PREINSTALLED_LINK="/usr/share/waydroid-extra/images"

log() {
    echo "$1"
    logger -t "$LOG_TAG" "$1"
}

# Check if already initialized
if [ -f "$FLAG_FILE" ]; then
    log "Waydroid Panthor already initialized, skipping"
    exit 0
fi

log "Starting Waydroid Panthor initialization..."

# Require pre-installed images — this service never downloads.
# Install waydroid-panthor-images to provide the Panthor-compatible images.
if [ ! -f "$IMAGES_DIR/system.img" ] || [ ! -f "$IMAGES_DIR/vendor.img" ]; then
    log "ERROR: Waydroid images not found in $IMAGES_DIR"
    log "       Install waydroid-panthor-images to provide Panthor-compatible images"
    exit 1
fi
log "Found pre-installed images in $IMAGES_DIR"

# Verify the preinstalled images symlink exists. Without it, waydroid init
# won't recognize the images as preinstalled and will try to download.
if [ ! -e "$PREINSTALLED_LINK" ]; then
    log "ERROR: Preinstalled images symlink missing at $PREINSTALLED_LINK"
    log "       The waydroid-panthor-config package may need reinstalling"
    exit 1
fi

# Check that binder devices are available
if [ ! -e /dev/binder ]; then
    log "ERROR: /dev/binder not found - binder setup service may not have run"
    log "       Ensure dev-binderfs.mount and waydroid-binder-setup.service are started"
    exit 1
fi

# Verify binder devices
for dev in /dev/binder /dev/hwbinder /dev/vndbinder; do
    if [ ! -e "$dev" ]; then
        log "WARNING: $dev not found, waydroid may not work correctly"
    else
        log "Found binder device: $dev"
    fi
done

# Find the Panthor render device
RENDER_DEVICE=""
for dev in /dev/dri/renderD*; do
    if [ -e "$dev" ]; then
        # Check if this is the Panthor device by looking at the driver
        CARD_NUM=$(basename "$dev" | sed 's/renderD//')
        CARD_PATH="/sys/class/drm/renderD${CARD_NUM}/device/driver"
        if [ -L "$CARD_PATH" ]; then
            DRIVER=$(basename "$(readlink "$CARD_PATH")")
            if [ "$DRIVER" = "panthor" ]; then
                RENDER_DEVICE="$dev"
                log "Found Panthor render device: $RENDER_DEVICE (driver: $DRIVER)"
                break
            fi
        fi
    fi
done

if [ -z "$RENDER_DEVICE" ]; then
    log "WARNING: Panthor render device not found, using default renderD128"
    RENDER_DEVICE="/dev/dri/renderD128"
fi

# Initialize Waydroid using pre-installed images.
# The symlink at /usr/share/waydroid-extra/images makes waydroid detect them
# as preinstalled, which sets OTA to "None" — no network downloads occur.
# Do NOT pass -f (forces redownload) or -i (bypasses preinstalled detection).
rm -f /var/lib/waydroid/waydroid.cfg
log "Running waydroid init with pre-installed images..."
waydroid init

# Verify LXC container was created
if [ ! -d /var/lib/waydroid/lxc/waydroid ]; then
    log "ERROR: LXC container was not created at /var/lib/waydroid/lxc/waydroid/"
    log "       waydroid init may have failed silently"
    exit 1
fi
log "LXC container created successfully"

# Patch LXC config_nodes to bind the correct render device into the container.
# waydroid init defaults to renderD128, but on RK3588 the Panthor GPU is
# typically at a higher number (e.g., renderD130). Without this, the Android
# container cannot access the Panthor GPU at all.
NODES_FILE="/var/lib/waydroid/lxc/waydroid/config_nodes"
RENDER_BASENAME=$(basename "$RENDER_DEVICE")
if [ -f "$NODES_FILE" ] && [ "$RENDER_DEVICE" != "/dev/dri/renderD128" ]; then
    if grep -q "renderD128" "$NODES_FILE" && ! grep -q "$RENDER_BASENAME" "$NODES_FILE"; then
        sed -i "s|/dev/dri/renderD128 dev/dri/renderD128|$RENDER_DEVICE dev/dri/$RENDER_BASENAME|g" "$NODES_FILE"
        log "Patched config_nodes: renderD128 -> $RENDER_BASENAME"
    fi
fi

# Patch gralloc.gbm.device in waydroid_base.prop and waydroid.prop.
# waydroid init hardcodes renderD128, but gralloc must use the Panthor device.
for PROP_FILE in /var/lib/waydroid/waydroid_base.prop /var/lib/waydroid/waydroid.prop; do
    if [ -f "$PROP_FILE" ]; then
        if grep -q "gralloc.gbm.device=/dev/dri/renderD128" "$PROP_FILE"; then
            sed -i "s|gralloc.gbm.device=/dev/dri/renderD128|gralloc.gbm.device=$RENDER_DEVICE|g" "$PROP_FILE"
            log "Patched gralloc.gbm.device in $(basename "$PROP_FILE") -> $RENDER_DEVICE"
        fi
    fi
done

# Configure properties directly in waydroid.cfg since the container
# service may not be running yet (waydroid prop set requires D-Bus).
CFG_FILE="/var/lib/waydroid/waydroid.cfg"
log "Configuring Panthor render device: $RENDER_DEVICE"
if [ -f "$CFG_FILE" ]; then
    python3 -c "
import configparser
cfg = configparser.ConfigParser()
cfg.read('$CFG_FILE')
if not cfg.has_section('properties'):
    cfg.add_section('properties')
cfg.set('properties', 'persist.waydroid.render_device', '$RENDER_DEVICE')
cfg.set('properties', 'ro.hardware.gralloc', 'gbm')
cfg.set('properties', 'ro.hardware.egl', 'mesa')
with open('$CFG_FILE', 'w') as f:
    cfg.write(f)
"
    log "Properties written to $CFG_FILE"
else
    log "WARNING: $CFG_FILE not found, cannot set properties"
fi

# Create flag file to prevent re-running
touch "$FLAG_FILE"
log "Waydroid Panthor initialization complete!"
